{
  "name": "creighton-model-chart",
  "version": "1.0.0",
  "description": "Creighton Model NaProTRACKING chart editor",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.creightonmodel.chart",
    "productName": "Creighton Model Chart",
    "mac": {
      "category": "public.app-category.medical",
      "target": ["dmg", "zip"]
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ]
  }
}
